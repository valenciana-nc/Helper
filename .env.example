# Copy to .env and fill in. Do not commit .env.

# Optional. Only needed for voice features (mic transcription + spoken replies).
# Chat and computer-use are powered by your ChatGPT/Codex subscription via the
# "Sign in with ChatGPT" button in the dashboard — no API key required for those.
OPENAI_API_KEY=

# Provider selection. One of: codex, openai_compat, anthropic, gemini, xai.
#   codex          — sign in with ChatGPT (default, no API key needed for chat)
#   openai_compat  — any OpenAI-compatible /v1/chat/completions endpoint
#   anthropic      — Claude (Pro/Max OAuth in Account, or an Anthropic API key)
#   gemini         — Google Gemini (needs HELPER_GEMINI_API_KEY)
#   xai            — Grok (native subscription sign-in in Account, or an xAI API key)
HELPER_PROVIDER=codex

# Per-provider API keys. Only the key for the active provider is used.
HELPER_ANTHROPIC_API_KEY=
# Claude auth: auto prefers an existing API key, otherwise subscription OAuth.
# Account selects oauth or api_key explicitly. Tokens stay in the credential manager.
HELPER_ANTHROPIC_AUTH_MODE=auto
HELPER_GEMINI_API_KEY=
HELPER_XAI_API_KEY=
# Grok auth: auto prefers an existing API key, otherwise subscription OAuth.
# The Account card selects oauth or api_key explicitly. OAuth tokens are kept
# in the system credential manager, never in this file.
HELPER_XAI_AUTH_MODE=auto

# Optional. OpenAI-compatible endpoint config (used when HELPER_PROVIDER=openai_compat,
# or as the legacy fallback when both base URL + key are set).
HELPER_API_BASE_URL=
HELPER_API_KEY=
HELPER_API_MODEL=

HELPER_HOTKEY=ctrl+shift+space
# Desktop chat automatically answers questions or performs requested computer tasks.

# Agent / vision / computer use
HELPER_AGENT_MODEL=gpt-6-luna
HELPER_REASONING_MODEL=gpt-6-luna
HELPER_SPEAK_TYPED_CHAT=false

# Generation parameters (sent to providers that accept them — codex ignores).
HELPER_TEMPERATURE=0.7
HELPER_MAX_TOKENS=4096

# UI appearance — light or dark.
HELPER_THEME=light

# Audio (requires OPENAI_API_KEY)
HELPER_STT_MODEL=whisper-1
HELPER_TTS_MODEL=gpt-4o-mini-tts
HELPER_TTS_VOICE=alloy
HELPER_AUDIO_SAMPLE_RATE=16000
HELPER_AUDIO_CHANNELS=1
HELPER_AUDIO_BLOCKSIZE=0
HELPER_AUDIO_SILENCE_THRESHOLD=700
HELPER_AUDIO_MIN_SECONDS=0.25
HELPER_AUDIO_TRIM_PAD_MS=150

HELPER_MAX_AGENT_STEPS=25
HELPER_AGENT_TIMEOUT_SEC=180
HELPER_SCREENSHOT_MAX_EDGE=1280
HELPER_HISTORY_MAX_TURNS=12
HELPER_HISTORY_MAX_TOKENS=12000
HELPER_LOOP_SETTLE_MS=350

# Observation-driven computer use. desktop is the Windows UIA + vision default.
# browser uses an isolated Chromium session unless an explicit endpoint is supplied.
# hybrid enriches the foreground browser app with an explicitly selected CDP tab.
HELPER_CONTROL_BACKEND=desktop
# Optional loopback debugging endpoint for a browser you explicitly enable.
HELPER_BROWSER_CDP_URL=
# Required for a CDP browser that has more than one tab. Zero-based.
HELPER_BROWSER_PAGE_INDEX=
# Per-run budget; unset uses HELPER_AGENT_TIMEOUT_SEC.
HELPER_RUN_TIMEOUT_SEC=180
# How long Help mode waits for the user to perform a highlighted step.
HELPER_GUIDE_WAIT_SEC=90
